# -------------------------------------------------------------
# ScholarFlow Environment Configuration (.env.example)
# Copy to .env.local for local development. NEVER commit secrets.
# -------------------------------------------------------------

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/scholarflow?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/scholarflow?schema=public"

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder

# Cryptographic Keys & Salts (DPDP & Audit Compliance)
# Generate with: openssl rand -hex 32
AADHAAR_HMAC_SALT=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BANK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUDIT_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLM Providers for Document Extraction
GEMINI_API_KEY=placeholder_gemini_api_key
ANTHROPIC_API_KEY=placeholder_anthropic_api_key

# Event Pipeline & Background Jobs (Inngest)
INNGEST_EVENT_KEY=placeholder_inngest_key
INNGEST_SIGNING_KEY=placeholder_inngest_signing_key

# Object Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=scholarflow-documents
STORAGE_ACCESS_KEY_ID=placeholder_key
STORAGE_SECRET_ACCESS_KEY=placeholder_secret

# Notifications (Resend / SMS / WhatsApp Sandbox)
RESEND_API_KEY=re_placeholder

# Sentry & Observability
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
